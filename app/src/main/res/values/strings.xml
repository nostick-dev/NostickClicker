    <string name="version_fmt">Version %s</string>
    <string name="accessibility_description">NostickClicker uses the Accessibility API solely to simulate automated touch gestures at locations you choose. It does not read screen content, collect data, or connect to the internet.</string>

    <!-- Prominent disclosure -->
    <string name="disclosure_title">Before we begin</string>
    <string name="disclosure_section_what_title">🛡️ What NostickClicker uses</string>
    <string name="disclosure_section_what_body">NostickClicker uses Android\'s AccessibilityService API exclusively to simulate taps and swipes at the positions you place on screen. This is the only mechanism that allows gesture injection on unrooted devices.</string>
    <string name="disclosure_section_no_title">🔒 What we never do</string>
    <string name="disclosure_section_no_body">We never read, collect, store or share personal data, app content or screen information. We do not access your contacts, messages, files, location, camera or microphone. Nothing ever leaves your device.</string>
    <string name="disclosure_section_offline_title">📴 100% offline by design</string>
    <string name="disclosure_section_offline_body">NostickClicker has no internet permission and never connects to a server. Everything you set up stays on your device, and the app works without a network.</string>
    <string name="disclosure_understand">I understand — continue</string>
    <string name="disclosure_exit">Exit</string>

